{
  "specVersion": "1.3.0",
  "note": "HAND-OWNED. Twenty-one deliberately awkward structures, each stating the assumption it falsifies, plus the cases that attack them and the labeled clean controls that make a false-positive rate reportable. Every case is SYNTHETIC and author-invented: it proves a structure exists that a naive engine mishandles, never that the mishandling has occurred in production. Typed outcomes separate awkward context from observed system treatment. A defect requires one context-backed expected-versus-observed mismatch. A clean control may carry awkward context only when every active semantic treatment is correct.",
  "assumptions": [
    { "id": "AS-01", "structure": "Two households share the surname Smith and a trust name contains it.", "falsifies": "Name resolution is unique." },
    { "id": "AS-02", "structure": "Mira Smith heads her own household and is an authorized signer on her parents' joint account.", "falsifies": "One person belongs to one household." },
    { "id": "AS-03", "structure": "The Smith Family Trust owns one account and is a beneficiary of another.", "falsifies": "Ownership and beneficiary graphs are disjoint." },
    { "id": "AS-04", "structure": "The LLC operating account's authorized signer is not a member of the LLC's household.", "falsifies": "Authority derives from household membership." },
    { "id": "AS-05", "structure": "The two owners of one joint account carry conflicting distribution instructions.", "falsifies": "A household has one instruction set." },
    { "id": "AS-06", "structure": "One bank instruction serves two accounts and was changed once.", "falsifies": "A destination change's blast radius is one account." },
    { "id": "AS-07", "structure": "Two bank instructions share a bank and a last-four; one is verified, one is not.", "falsifies": "Bank plus last-four identifies a destination." },
    { "id": "AS-08", "structure": "A beneficiary designation names a party the household's destination restriction forbids paying.", "falsifies": "Instruction planes never collide." },
    { "id": "AS-09", "structure": "A signer's authority lapses between the evidence's observedAt and its retrievedAt.", "falsifies": "Evidence is a point, not an interval." },
    { "id": "AS-10", "structure": "The source account carries a model assignment with a pending rebalance.", "falsifies": "Balance is static during evaluation." },
    { "id": "AS-11", "structure": "The withdrawal schedule is segmented: 8,000 USD monthly, then 12,000 USD monthly.", "falsifies": "reserveFloor = monthly x months." },
    { "id": "AS-12", "structure": "A household has no planned-withdrawal schedule at all.", "falsifies": "A reserve floor is always computable." },
    { "id": "AS-13", "structure": "The household carries one expired-but-recorded restriction and one future-dated restriction.", "falsifies": "Recorded implies in force." },
    { "id": "AS-14", "structure": "A legal hold covers one position, not the whole account.", "falsifies": "Holds are account-scoped." },
    { "id": "AS-15", "structure": "One pending action is itself blocked.", "falsifies": "All pending activity reduces effective liquidity equally." },
    { "id": "AS-16", "structure": "The account's change history straddles a US daylight-saving fall-back and the following spring-forward.", "falsifies": "A fixed -04:00 offset is safe." },
    { "id": "AS-17", "structure": "A roster name carries a composed non-ASCII character requiring NFC normalization.", "falsifies": "Identity is ASCII, and canonical bytes are spelling-independent." },
    { "id": "AS-18", "structure": "Request amounts land on the exact authority thresholds, 25,000 USD and 100,000 USD.", "falsifies": "'Above' and 'at or above' are interchangeable." },
    { "id": "AS-19", "structure": "A request's deadline precedes the decision instant.", "falsifies": "Deadlines are always in the future." },
    { "id": "AS-20", "structure": "The only account with sufficient liquidity is a retirement account.", "falsifies": "A liquidity check is source-agnostic." },
    { "id": "AS-21", "structure": "The IRA's model assignment was last observed twelve weeks ago - far beyond its seven-day freshness window - while its business date says nothing about when it was last checked.", "falsifies": "A record in the system is a record observed now." }
  ],
