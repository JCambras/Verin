# Verin environment template — PLACEHOLDER VALUES ONLY.
#
# Charter non-negotiable #7: this file must never contain a real secret, live org
# domain, username, or credential. CI fails the build if it does (see the
# no-secret-fallback / no-live-org-domain fence). Copy to `.env.local` and fill in
# real values locally; never commit the filled copy.
#
# Every key here is read ONLY by src/infrastructure/config (charter #7, fence:
# no-process-env). No other module may read process.env.

# --- Runtime ---
NODE_ENV=development
# Real deployment environment: development | staging | production. ALL production
# fail-closed guards and the secure-cookie flag key on APP_ENV, never NODE_ENV
# (next build/start force NODE_ENV=production even in dev/CI). Boot fails FATAL
# if NODE_ENV=production and APP_ENV is unset.
APP_ENV=development
APP_URL=http://localhost:3000
# IANA timezone of the operating firm. Never hardcoded in source.
# Accepted values: any identifier of the CURRENT version-pinned tzdb release, today
# iana-tzdb/2026b (src/contracts/iana-time-zones-2026b.json) - its 341 canonical Zone
# names plus the 257 Link aliases (src/contracts/iana-time-zone-links-2026b.json).
# Boot fails FATAL on anything else; validation never consults host ICU data, so it
# cannot drift with the OS. A Link alias is resolved through THAT SAME release to its
# canonical Zone and ONLY the Zone is stored and hashed, so replay bytes stay
# single-valued: UTC -> Etc/UTC, US/Eastern -> America/New_York, Asia/Calcutta ->
# Asia/Kolkata, Europe/Kiev -> Europe/Kyiv.
# Older supported releases stay readable for ALREADY-PERSISTED records, but are NOT
# accepted here: a new record stamps the current release, so a zone only an older one
# shipped must fail at boot rather than at every later parse.
# Migration: none - every value that booted before ADR-0029 still boots.
FIRM_TIMEZONE=America/New_York

# --- House-CRM store (charter: PostgreSQL behind the store port) ---
# Driver selects the adapter behind the store interface (SqlDb). "pglite" = embedded Postgres
# (dev/CI, durable to VERIN_DATA_DIR). "postgres" = managed Postgres via DATABASE_URL.
VERIN_STORE_DRIVER=pglite
VERIN_DATA_DIR=.verin-data
# Only used when VERIN_STORE_DRIVER=postgres. Placeholder — never a live DSN.
DATABASE_URL=postgres://USER:CHANGEME_PASSWORD@HOST:5432/verin

# --- Identity / sessions (charter #12: real auth, no secret fallbacks) ---
# 32+ char random secret. Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGEME_generate_a_32plus_char_random_secret
SESSION_TTL_MINUTES=60

# --- Simulated e-sign webhook (charter deliverable E) ---
# HMAC secret the webhook uses to authenticate the fire-and-return callback.
ESIGN_WEBHOOK_SECRET=CHANGEME_generate_a_32plus_char_random_secret

# --- Observability (charter #14) ---
LOG_LEVEL=info
OTEL_SERVICE_NAME=verin
# Optional OTLP collector endpoint. Set => spans are exported over OTLP/HTTP
# (otel-provider.ts registers the exporting provider); unset => no exporter is
# registered and spans stay in the in-process test ring (ADR-0013).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
